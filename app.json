{
  "expo": {
    "name": "ReciclaSpot",
    "slug": "reciclaspot",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/icon.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ],
      "package": "com.emilly.nascimento.reciclaspot",
      "config": {
        "googleMaps": {
          "apiKey": "SUA_CHAVE_GOOGLE_MAPS_AQUI"
        }
      }
    },
    "web": {
      "favicon": "./assets/icon.png"
    },
    "plugins": [
      "expo-font",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "O ReciclaSpot usa sua localização para mostrar os ecopontos mais próximos de você."
        }
      ],
      [
        "expo-image-picker",
        {
          "cameraPermission": "O ReciclaSpot usa a câmera para você fotografar e registrar seus descartes.",
          "photosPermission": false,
          "microphonePermission": false
        }
      ],
      "expo-asset",
      "expo-sqlite"
    ],
    "extra": {
      "eas": {
        "projectId": "0692a828-9798-4b30-ada5-eef6fd3b3fd3"
      }
    }
  }
}
